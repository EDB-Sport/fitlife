# Analyzer settings for every project (docs/TECHNICAL_REFERENCE.md sections 2 and 3).
# Every disabled rule has a reason. Code-owned: changes need a review from the maintainers.
is_global = true

# --- Disabled rules ---

# CA2007 ConfigureAwait: ASP.NET Core has no synchronization context
dotnet_diagnostic.CA2007.severity = none
# CA1303 localization of literals: not needed
dotnet_diagnostic.CA1303.severity = none
# CA1062 argument null checks: nullable reference types cover them
dotnet_diagnostic.CA1062.severity = none
# CA1848 LoggerMessage delegates: plain ILogger templates are what the course teaches, and read better (CA2254 stays on)
dotnet_diagnostic.CA1848.severity = none
# CA1515 make public types internal: public types are needed for XML comments and WebApplicationFactory<Program>
dotnet_diagnostic.CA1515.severity = none

# --- Rules that are off by default and must be on ---

# Sonar size limits; the thresholds are in SonarLint.xml
dotnet_diagnostic.S3776.severity = error
dotnet_diagnostic.S134.severity = error
dotnet_diagnostic.S107.severity = error
dotnet_diagnostic.S138.severity = error
dotnet_diagnostic.S104.severity = error
dotnet_diagnostic.S1067.severity = error

# IDE0079 unnecessary suppression: suppressions whose warning has gone away are removed
dotnet_diagnostic.IDE0079.severity = error

# --- Code style (docs/TECHNICAL_REFERENCE.md section 5): explicit code is easier for a junior to read ---
# Enforced in the build (EnforceCodeStyleInBuild) and by dotnet format.

# var only when the type is apparent from the right-hand side (IDE0007, IDE0008)
csharp_style_var_for_built_in_types = false:error
csharp_style_var_when_type_is_apparent = true:error
csharp_style_var_elsewhere = false:error
dotnet_diagnostic.IDE0007.severity = error
dotnet_diagnostic.IDE0008.severity = error

# Braces always (IDE0011)
csharp_prefer_braces = true:error
dotnet_diagnostic.IDE0011.severity = error

# Block-bodied methods (IDE0022)
csharp_style_expression_bodied_methods = false:error
dotnet_diagnostic.IDE0022.severity = error

# File-scoped namespaces (IDE0161)
csharp_style_namespace_declarations = file_scoped:error
dotnet_diagnostic.IDE0161.severity = error

# Naming rules (IDE1006): types and members PascalCase, interfaces IPascalCase, private fields _camelCase
dotnet_diagnostic.IDE1006.severity = error

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.interface_style.required_prefix = I
dotnet_naming_style.interface_style.capitalization = pascal_case
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = interface_style
dotnet_naming_rule.interfaces_start_with_i.severity = error

# Constants and static fields are PascalCase
dotnet_naming_symbols.constants_and_static_fields.applicable_kinds = field
dotnet_naming_symbols.constants_and_static_fields.required_modifiers = static
dotnet_naming_style.pascal_style.capitalization = pascal_case
dotnet_naming_rule.constants_and_static_fields_pascal.symbols = constants_and_static_fields
dotnet_naming_rule.constants_and_static_fields_pascal.style = pascal_style
dotnet_naming_rule.constants_and_static_fields_pascal.severity = error

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, private_protected
dotnet_naming_style.underscore_camel_style.required_prefix = _
dotnet_naming_style.underscore_camel_style.capitalization = camel_case
dotnet_naming_rule.private_fields_underscore_camel.symbols = private_fields
dotnet_naming_rule.private_fields_underscore_camel.style = underscore_camel_style
dotnet_naming_rule.private_fields_underscore_camel.severity = error

dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, enum, property, method, event, delegate
dotnet_naming_rule.types_and_members_pascal.symbols = types_and_members
dotnet_naming_rule.types_and_members_pascal.style = pascal_style
dotnet_naming_rule.types_and_members_pascal.severity = error
