<!--
  Strictness settings (docs/TECHNICAL_REFERENCE.md section 2).
  This file is imported after each .csproj, so these values always win.
  Code-owned: changes need a review from the maintainers.
-->
<Project>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <Features>strict</Features>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Course rule #4: XML comments on all public code -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The SDK turns GenerateDocumentationFile into this path before this file is imported, so set the path too -->
    <DocumentationFile>$(IntermediateOutputPath)$(AssemblyName).xml</DocumentationFile>
    <!-- Microsoft.Common.CurrentVersion.targets computed this from the empty DocumentationFile before this file is imported.
         Without it the build never copies the .xml to bin/, and dotnet publish fails looking for it there (issue #64). -->
    <_DocumentationFileProduced>true</_DocumentationFileProduced>
    <Nullable>enable</Nullable>
    <!-- A fixed list: anything a .csproj puts in NoWarn is overwritten. 1701;1702 are the SDK defaults. -->
    <NoWarn>1701;1702</NoWarn>
  </PropertyGroup>

  <!-- Test projects: names like Reserve_ClassSessionFull_ReturnsConflict document themselves -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) Or $(MSBuildProjectName.EndsWith('.IntegrationTests'))">
    <NoWarn>$(NoWarn);CS1591;CA1707</NoWarn>
  </PropertyGroup>

  <!--
    No references between services (docs/TECHNICAL_REFERENCE.md section 1).
    A project under src/<A>/ may not reference a project under src/<B>/. Services talk over HTTP and events only.
  -->
  <PropertyGroup>
    <_FitLifeSrcRoot>$([MSBuild]::NormalizeDirectory('$(RepoRoot)', 'src'))</_FitLifeSrcRoot>
    <_FitLifeRelativeDir>$([MSBuild]::MakeRelative('$(_FitLifeSrcRoot)', '$(MSBuildProjectDirectory)').Replace('\', '/'))</_FitLifeRelativeDir>
    <_FitLifeService Condition="!$(_FitLifeRelativeDir.StartsWith('..'))">$(_FitLifeRelativeDir.Split('/')[0])</_FitLifeService>
  </PropertyGroup>

  <Target Name="FitLifeCheckNoCrossServiceReferences" BeforeTargets="ResolveProjectReferences" Condition="'$(_FitLifeService)' != ''">
    <ItemGroup>
      <_FitLifeReference Include="@(ProjectReference->'%(FullPath)')" />
      <_FitLifeReference>
        <RelativePath>$([MSBuild]::MakeRelative('$(_FitLifeSrcRoot)', '%(Identity)').Replace('\', '/'))</RelativePath>
      </_FitLifeReference>
      <_FitLifeReference>
        <Service>$([System.String]::Copy('%(RelativePath)').Split('/')[0])</Service>
      </_FitLifeReference>
      <_FitLifeCrossServiceReference Include="@(_FitLifeReference)"
                                     Condition="!$([System.String]::Copy('%(RelativePath)').StartsWith('..')) And '%(Service)' != '$(_FitLifeService)'" />
    </ItemGroup>
    <Error Condition="'@(_FitLifeCrossServiceReference)' != ''"
           Code="FITLIFE001"
           Text="Found a ProjectReference from src/$(_FitLifeService) to src/%(_FitLifeCrossServiceReference.Service). Remove it: services and UIs talk to each other over HTTP or RabbitMQ events only (docs/TECHNICAL_REFERENCE.md section 1)." />
  </Target>

  <!--
    contracts/openapi/<service>.json keeps \n line breaks on every platform (issue #395).
    On Windows the OpenAPI generator turns a line break in an XML comment into "\r\n" in a description,
    so a local build left a tracked contract changed. This rewrites the documents the build just wrote with \n only.
  -->
  <UsingTask TaskName="FitLifeUseLineFeeds" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        foreach (var file in Files)
        {
            string text = System.IO.File.ReadAllText(file.ItemSpec);
            string lineFeeds = text.Replace("\\r\\n", "\\n").Replace("\r\n", "\n");
            if (lineFeeds != text)
            {
                System.IO.File.WriteAllText(file.ItemSpec, lineFeeds, new System.Text.UTF8Encoding(false));
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="FitLifeOpenApiLineFeeds" AfterTargets="GenerateOpenApiDocuments" Condition="'$(_OpenApiDocumentsCache)' != '' And Exists('$(_OpenApiDocumentsCache)')">
    <ReadLinesFromFile File="$(_OpenApiDocumentsCache)">
      <Output TaskParameter="Lines" ItemName="_FitLifeOpenApiDocument" />
    </ReadLinesFromFile>
    <FitLifeUseLineFeeds Files="@(_FitLifeOpenApiDocument)" Condition="'@(_FitLifeOpenApiDocument)' != ''" />
  </Target>

  <!--
    Only this repo's .globalconfig counts (issue #434). The SDK adds every .globalconfig above a project, so a worktree
    inside another checkout (e.g. .claude/worktrees/<name>/) loads two. Roslyn then unsets every key they share,
    and the style rules, CA/S severities and naming rules are all off. The SDK's own analysis-level configs have
    other file names and stay.
  -->
  <Target Name="FitLifeOnlyRepoGlobalConfig" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_FitLifeOuterGlobalConfig Include="@(EditorConfigFiles)"
                                 Condition="'%(Filename)%(Extension)' == '.globalconfig' And !$([System.String]::Copy('%(FullPath)').Replace('\', '/').StartsWith($([System.String]::Copy('$(RepoRoot)').Replace('\', '/')), System.StringComparison.OrdinalIgnoreCase))" />
      <EditorConfigFiles Remove="@(_FitLifeOuterGlobalConfig)" />
    </ItemGroup>
  </Target>
</Project>
