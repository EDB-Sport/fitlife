<Project>
  <!--
    Central Package Management (docs/CSHARP_SETUP_TODO.md sections 1 and 3).
    Every package version lives here, one version per package across all services.
    A Version= on a PackageReference in a .csproj is error NU1008.
    Code-owned: changes need a review from the maintainers.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Analyzers for every project, tests included -->
  <ItemGroup Label="Analyzers">
    <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.37.0.15768" />
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.342" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <GlobalPackageReference Include="Nullable.Extended.Analyzer" Version="1.19.0" />
  </ItemGroup>

  <!-- Services. The OpenAPI document and Scalar are mapped in Development only (course rule #7). -->
  <ItemGroup Label="Services">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Scalar.AspNetCore" Version="3.1.1" />
    <!-- Writes contracts/openapi/<service>.json on build (docs/CSHARP_SETUP_TODO.md section 8) -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.15" />
    <!-- NLog → Loki (course rule #8, docs/CSHARP_SETUP_TODO.md section 7) -->
    <PackageVersion Include="NLog.Web.AspNetCore" Version="6.2.2" />
    <PackageVersion Include="NLog.Targets.Loki" Version="2.7.1" />
  </ItemGroup>

  <!-- Added to every test project automatically by tests/Directory.Build.props. -->
  <ItemGroup Label="Test framework">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
  </ItemGroup>

  <!-- UI component tests (bUnit) -->
  <ItemGroup Label="UI tests">
    <PackageVersion Include="bunit" Version="2.15.2" />
  </ItemGroup>

  <!-- Referenced by a test project when it needs them (tests/README.md). -->
  <ItemGroup Label="Unit tests">
    <!-- Never 4.20.0, the SponsorLink release (docs/CSHARP_SETUP_TODO.md section 6). -->
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.1" />
  </ItemGroup>

  <!-- Integration tests only. tests/Directory.Build.targets fails a *.Tests project that references these. -->
  <ItemGroup Label="Integration tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.17.0" />
  </ItemGroup>

  <!--
    The project's own analyzers in tools/Analyzers (docs/CSHARP_SETUP_TODO.md section 4).
    Microsoft.CodeAnalysis.CSharp stays at 5.0.0, which is not newer than the Roslyn of the SDK in global.json (10.0.203):
    an analyzer built against a newer Roslyn than the compiler that loads it is not loaded (CS8032).
  -->
  <ItemGroup Label="Roslyn analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <!-- Transitive through the testing package (NuGet.Packaging 7.0.3 asks for 9.0.6, GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7) -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>
</Project>
