{
  "openapi": "3.1.1",
  "info": {
    "title": "BookingService | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/class-sessions": {
      "get": {
        "tags": [
          "ClassSchedule"
        ],
        "summary": "Lists the upcoming class sessions of a centre, or of every centre, by start, with names and free seats. No login needed.",
        "description": "Only class sessions that start after now. A cancelled one has no free seats. An unknown centre or class type has an empty name.",
        "parameters": [
          {
            "name": "centerId",
            "in": "query",
            "description": "The centre; leave it out for every centre.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClassSessionResponse"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClassSessionResponse"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClassSessionResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "ClassSchedule"
        ],
        "summary": "Schedules a class session (#238). It then shows in the class schedule, and members can reserve a seat on it.",
        "requestBody": {
          "description": "Stops the request.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScheduleClassSessionRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ScheduleClassSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ClassSessionResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassSessionResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassSessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "The start is not after now, the capacity or the duration is under 1, or the instructor's name is missing.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "The token has neither the role Træner nor Admin.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No such center or class type.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/class-sessions/{id}/cancellation": {
      "post": {
        "tags": [
          "ClassSchedule"
        ],
        "summary": "Cancels a class session (#239): its reservations and waitlist entries are removed, the class schedule shows it as cancelled\nand nobody can reserve a seat on it. The members are not told yet (#242, #222).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The class session.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "The token has neither the role Træner nor Admin.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No such class session (code ClassSessionNotFound).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "The class session is already cancelled (code ClassSessionAlreadyCancelled), has started (code ClassSessionStarted), or another request changed it at the same time (code ChangedMeanwhile).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/class-sessions/{id}/reservations": {
      "post": {
        "tags": [
          "ClassSessions"
        ],
        "summary": "Reserves a seat for the member behind the token (#260). Membership says who the member is and whether they may book.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The class session.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "The token has no role Medlem, or the account has no active membership (code MembershipNotActive).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "The class session rejected the reservation; code is the reason, e.g. ClassSessionFull or TooFarAhead.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Membership didn't answer (code MembershipUnavailable).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/class-sessions/{id}/reservations/{memberId}": {
      "delete": {
        "tags": [
          "ClassSessions"
        ],
        "summary": "Cancels the member's reservation. When someone is on the waitlist, the first waitlist entry gets the seat.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The class session.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "memberId",
            "in": "path",
            "description": "The member who gives up the seat.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "No such class session, or the member has no seat on it.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/class-sessions/{id}/waitlist": {
      "post": {
        "tags": [
          "ClassSessions"
        ],
        "summary": "Puts the member at the end of the waitlist of a full class session.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The class session.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "Stops the request.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WaitlistEntryRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/WaitlistEntryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/WaitlistEntryResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WaitlistEntryResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/WaitlistEntryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "A seat is free, the waitlist has closed, the class session is cancelled, or the member already has a place.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClassSessionResponse": {
        "required": [
          "id",
          "centerId",
          "centerName",
          "classTypeId",
          "classTypeName",
          "instructorName",
          "startTime",
          "durationMinutes",
          "capacity",
          "freeSeats",
          "isCancelled"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The class session's id.",
            "format": "uuid"
          },
          "centerId": {
            "type": "string",
            "description": "The centre it takes place in.",
            "format": "uuid"
          },
          "centerName": {
            "type": "string",
            "description": "The centre's name; empty when Booking doesn't know the centre."
          },
          "classTypeId": {
            "type": "string",
            "description": "The kind of class it is a run of.",
            "format": "uuid"
          },
          "classTypeName": {
            "type": "string",
            "description": "The class type's name; empty when Booking doesn't know the class type."
          },
          "instructorName": {
            "type": "string",
            "description": "Who teaches it."
          },
          "startTime": {
            "type": "string",
            "description": "When it starts.",
            "format": "date-time"
          },
          "durationMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "How long it lasts, in minutes.",
            "format": "int32"
          },
          "capacity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "How many members can have a reservation.",
            "format": "int32"
          },
          "freeSeats": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "How many seats are not reserved yet; 0 when the class session is cancelled.",
            "format": "int32"
          },
          "isCancelled": {
            "type": "boolean",
            "description": "The class session will not take place (Hold aflyst)."
          }
        },
        "description": "One class session in the class schedule."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ReservationResponse": {
        "required": [
          "classSessionId",
          "memberId"
        ],
        "type": "object",
        "properties": {
          "classSessionId": {
            "type": "string",
            "description": "The class session.",
            "format": "uuid"
          },
          "memberId": {
            "type": "string",
            "description": "The member who has the seat.",
            "format": "uuid"
          }
        },
        "description": "A member's seat on a class session."
      },
      "ScheduleClassSessionRequest": {
        "required": [
          "centerId",
          "classTypeId",
          "instructorName",
          "startsAt",
          "durationMinutes",
          "capacity"
        ],
        "type": "object",
        "properties": {
          "centerId": {
            "type": "string",
            "description": "The centre it takes place in.",
            "format": "uuid"
          },
          "classTypeId": {
            "type": "string",
            "description": "The kind of class it is a run of.",
            "format": "uuid"
          },
          "instructorName": {
            "type": "string",
            "description": "Who teaches it."
          },
          "startsAt": {
            "type": "string",
            "description": "When it starts; after now.",
            "format": "date-time"
          },
          "durationMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "How long it lasts, in minutes; 1 or more.",
            "format": "int32"
          },
          "capacity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "How many members can have a reservation; 1 or more.",
            "format": "int32"
          }
        },
        "description": "The body of `POST /class-sessions` (#238)."
      },
      "WaitlistEntryRequest": {
        "required": [
          "memberId"
        ],
        "type": "object",
        "properties": {
          "memberId": {
            "type": "string",
            "description": "The member who wants to wait for a seat.",
            "format": "uuid"
          }
        },
        "description": "A member asks for a place on the waitlist of a full class session. Until #172, the member id comes in the body."
      },
      "WaitlistEntryResponse": {
        "required": [
          "classSessionId",
          "memberId"
        ],
        "type": "object",
        "properties": {
          "classSessionId": {
            "type": "string",
            "description": "The class session.",
            "format": "uuid"
          },
          "memberId": {
            "type": "string",
            "description": "The member who is waiting.",
            "format": "uuid"
          }
        },
        "description": "A member's place on the waitlist of a class session."
      }
    }
  },
  "tags": [
    {
      "name": "ClassSchedule"
    },
    {
      "name": "ClassSessions"
    }
  ]
}