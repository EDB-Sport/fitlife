{
  "openapi": "3.1.1",
  "info": {
    "title": "BookingService | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/class-sessions": {
      "get": {
        "tags": [
          "ClassSessions"
        ],
        "summary": "Lists the class sessions of a centre, or of every centre, with their free seats; a cancelled one has none. No login needed.",
        "parameters": [
          {
            "name": "centerId",
            "in": "query",
            "description": "The centre; leave it out for every centre.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClassSessionResponse"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClassSessionResponse"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ClassSessionResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/class-sessions/{id}/reservations": {
      "post": {
        "tags": [
          "ClassSessions"
        ],
        "summary": "Reserves a seat for the member.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The class session.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "Stops the request.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReservationRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ReservationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "The class session is full, cancelled or has started, or the member already has a seat.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "The class session starts more than 4 weeks from now.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/class-sessions/{id}/reservations/{memberId}": {
      "delete": {
        "tags": [
          "ClassSessions"
        ],
        "summary": "Cancels the member's reservation. When someone is on the waitlist, the first waitlist entry gets the seat.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The class session.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "memberId",
            "in": "path",
            "description": "The member who gives up the seat.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "No such class session, or the member has no seat on it.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/class-sessions/{id}/waitlist": {
      "post": {
        "tags": [
          "ClassSessions"
        ],
        "summary": "Puts the member at the end of the waitlist of a full class session.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The class session.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "Stops the request.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WaitlistEntryRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/WaitlistEntryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/WaitlistEntryResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WaitlistEntryResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/WaitlistEntryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "A seat is free, the waitlist has closed, the class session is cancelled, or the member already has a place.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClassSessionResponse": {
        "required": [
          "id",
          "centerId",
          "classTypeId",
          "startTime",
          "capacity",
          "freeSeats",
          "isCancelled"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The class session's id.",
            "format": "uuid"
          },
          "centerId": {
            "type": "string",
            "description": "The centre it takes place in.",
            "format": "uuid"
          },
          "classTypeId": {
            "type": "string",
            "description": "The kind of class it is a run of.",
            "format": "uuid"
          },
          "startTime": {
            "type": "string",
            "description": "When it starts.",
            "format": "date-time"
          },
          "capacity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "How many members can have a reservation.",
            "format": "int32"
          },
          "freeSeats": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "How many seats are not reserved yet; 0 when the class session is cancelled.",
            "format": "int32"
          },
          "isCancelled": {
            "type": "boolean",
            "description": "The class session will not take place (Hold aflyst)."
          }
        },
        "description": "One class session in the class schedule."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ReservationRequest": {
        "required": [
          "memberId"
        ],
        "type": "object",
        "properties": {
          "memberId": {
            "type": "string",
            "description": "The member who wants the seat.",
            "format": "uuid"
          }
        },
        "description": "A member asks for a seat. Until the JWT issue (#172), the member id comes in the body."
      },
      "ReservationResponse": {
        "required": [
          "classSessionId",
          "memberId"
        ],
        "type": "object",
        "properties": {
          "classSessionId": {
            "type": "string",
            "description": "The class session.",
            "format": "uuid"
          },
          "memberId": {
            "type": "string",
            "description": "The member who has the seat.",
            "format": "uuid"
          }
        },
        "description": "A member's seat on a class session."
      },
      "WaitlistEntryRequest": {
        "required": [
          "memberId"
        ],
        "type": "object",
        "properties": {
          "memberId": {
            "type": "string",
            "description": "The member who wants to wait for a seat.",
            "format": "uuid"
          }
        },
        "description": "A member asks for a place on the waitlist of a full class session. Until #172, the member id comes in the body."
      },
      "WaitlistEntryResponse": {
        "required": [
          "classSessionId",
          "memberId"
        ],
        "type": "object",
        "properties": {
          "classSessionId": {
            "type": "string",
            "description": "The class session.",
            "format": "uuid"
          },
          "memberId": {
            "type": "string",
            "description": "The member who is waiting.",
            "format": "uuid"
          }
        },
        "description": "A member's place on the waitlist of a class session."
      }
    }
  },
  "tags": [
    {
      "name": "ClassSessions"
    }
  ]
}