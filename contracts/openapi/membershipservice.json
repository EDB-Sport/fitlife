{
  "openapi": "3.1.1",
  "info": {
    "title": "MembershipService | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/members": {
      "post": {
        "tags": [
          "Members"
        ],
        "summary": "The account in the token joins FitLife and gets an active membership",
        "operationId": "JoinMembership",
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/members/by-account/{accountId}": {
      "get": {
        "tags": [
          "Members"
        ],
        "summary": "The member id of an account, and whether its membership is active",
        "operationId": "GetMemberByAccount",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemberResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/members/me": {
      "get": {
        "tags": [
          "Members"
        ],
        "summary": "The membership of the account in the token: type, status and start date",
        "operationId": "GetMyMembership",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyMembershipResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/members/me/payment": {
      "post": {
        "tags": [
          "Members"
        ],
        "summary": "The account in the token pays the missing fee of a membership with Betaling mangler, which becomes Aktiv",
        "operationId": "PayMembership",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyMembershipResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MemberResponse": {
        "required": [
          "memberId",
          "membershipStatus",
          "isActive"
        ],
        "type": "object",
        "properties": {
          "memberId": {
            "type": "string",
            "description": "The member id other contexts store.",
            "format": "uuid"
          },
          "membershipStatus": {
            "description": "Where the membership is in its life.",
            "$ref": "#/components/schemas/MembershipStatus"
          },
          "isActive": {
            "type": "boolean",
            "description": "Whether the member may book and enter."
          }
        },
        "description": "A member and whether the membership gives access and the right to book."
      },
      "MembershipStatus": {
        "enum": [
          "Active",
          "PaymentMissing"
        ],
        "description": "Medlemskabets tilstand: where a membership is in its life (TO-BE-kontekst §8). Only MembershipStatus.Active\ngives access and the right to book. The other states (Pause, Opsagt, Afsluttet) come with their issues."
      },
      "MembershipType": {
        "enum": [
          "Standard"
        ],
        "description": "Medlemstype: the kind of membership offered. The case has exactly one today [PB p. 3]."
      },
      "MyMembershipResponse": {
        "required": [
          "memberId",
          "membershipType",
          "membershipStatus",
          "isActive",
          "startDate"
        ],
        "type": "object",
        "properties": {
          "memberId": {
            "type": "string",
            "description": "The member id.",
            "format": "uuid"
          },
          "membershipType": {
            "description": "The kind of membership.",
            "$ref": "#/components/schemas/MembershipType"
          },
          "membershipStatus": {
            "description": "Where the membership is in its life.",
            "$ref": "#/components/schemas/MembershipStatus"
          },
          "isActive": {
            "type": "boolean",
            "description": "Whether the member may book and enter."
          },
          "startDate": {
            "type": "string",
            "description": "The day the membership started.",
            "format": "date"
          }
        },
        "description": "The signed-in member's own membership, for the page \"Mit medlemskab\" (#210)."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Members"
    }
  ]
}