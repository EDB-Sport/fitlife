# Copy to .env in this folder (git-ignored) and change the passwords: cp .env.example .env
# docker compose reads .env from here automatically. CI copies this file as it is.

# MongoDB admin, used only by the init script and for debugging.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-root

# One password per service database (users booking-svc, membership-svc, ...).
BOOKING_DB_PASSWORD=change-me-booking
MEMBERSHIP_DB_PASSWORD=change-me-membership
IDENTITY_DB_PASSWORD=change-me-identity
NOTIFICATION_DB_PASSWORD=change-me-notification

RABBITMQ_USERNAME=fitlife
RABBITMQ_PASSWORD=change-me-rabbitmq

# Vault (dev mode). The root token is what you log in with at http://localhost:8200, and what the
# seed job and, later, the services use. The seed job writes the values above into Vault.
VAULT_DEV_ROOT_TOKEN=change-me-vault-root-token
# Signs and checks the JWTs (HMAC-SHA256), so at least 32 characters.
JWT_SIGNING_KEY=change-me-jwt-signing-key-at-least-32-chars

# The demo accounts' passwords (#237): made-up demo data, passed straight to identity-svc, not into Vault.
# The Postman environments local and ci use the same values.
DEMO_MEDLEM_PASSWORD=change-me-demo-medlem
DEMO_TRAENER_PASSWORD=change-me-demo-traener
DEMO_ADMIN_PASSWORD=change-me-demo-admin

# Grafana admin, at http://localhost:8080/grafana/ (through the gateway).
GRAFANA_ADMIN_USER=fitlife-admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Log-ins per client address on POST /api/identity/tokens (#366): Nginx's rate (r/s or r/m) and burst.
# Above them the gateway answers 429 and Identity never sees the request.
LOGIN_RATE_LIMIT=10r/m
LOGIN_RATE_BURST=10

# Ports on your machine. Containers reach each other inside the stack and don't use these.
# Change one if something else on your machine already uses it.
GATEWAY_PORT=8080
MONGO_HOST_PORT=27018
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
VAULT_HOST_PORT=8200
LOKI_HOST_PORT=3100
