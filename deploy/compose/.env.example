# Copy to .env in this folder (git-ignored) and change the passwords: cp .env.example .env
# docker compose reads .env from here automatically. CI copies this file as it is.

# MongoDB admin, used only by the init script and for debugging.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-root

# One password per service database (users booking-svc, membership-svc, ...).
BOOKING_DB_PASSWORD=change-me-booking
MEMBERSHIP_DB_PASSWORD=change-me-membership
IDENTITY_DB_PASSWORD=change-me-identity
NOTIFICATION_DB_PASSWORD=change-me-notification

RABBITMQ_USERNAME=fitlife
RABBITMQ_PASSWORD=change-me-rabbitmq

# Ports on your machine. Containers reach each other inside the stack and don't use these.
# Change one if something else on your machine already uses it.
GATEWAY_PORT=8080
MONGO_HOST_PORT=27018
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
