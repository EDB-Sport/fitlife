# The API gateway. One template for compose and Azure (docs/TECHNICAL_REFERENCE.md section 9a).
# The nginx image renders it with envsubst at start, so ${...} comes from the container's environment
# and the upstream addresses are configuration, not code (course rule #13).
#
# The upstreams are kept in variables, so Nginx starts even when a service isn't running yet.
# That service's route then answers 502 until it is up.

resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

# Keep the caller's correlation ID, or create one (section 7). Every service logs it.
map $http_x_correlation_id $correlation_id {
    ""      $request_id;
    default $http_x_correlation_id;
}

# In Azure, Caddy terminates HTTPS in front of Nginx and sends X-Forwarded-Proto: https.
# Pass that on, so the apps know the caller used HTTPS. Without Caddy (compose) it is $scheme.
map $http_x_forwarded_proto $forwarded_proto {
    ""      $scheme;
    default $http_x_forwarded_proto;
}

# Log-in attempts per client address (#366), so nobody can try passwords fast. Above the rate and the burst
# Nginx answers 429 and Identity never sees the request. 10m of state holds about 160,000 addresses.
limit_req_zone $binary_remote_addr zone=login:10m rate=${LOGIN_RATE_LIMIT};
limit_req_status 429;

# In Azure, Caddy is the client Nginx sees (127.0.0.1) and sends the caller's address in X-Forwarded-For.
# Trust that header only from 127.0.0.1, or a client could pick its own address and its own limit.
# In compose nothing connects from 127.0.0.1, so the address is the connecting one.
set_real_ip_from 127.0.0.1;
real_ip_header X-Forwarded-For;

# WebSocket upgrades (the member portal's Blazor Interactive Server SignalR connection, Grafana Live),
# passed on only when asked for.
map $http_upgrade $connection_upgrade {
    ""      "";
    default upgrade;
}

server {
    listen 80;

    # Set here, not per location: a proxy_set_header in a location would drop all of these there.
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;
    proxy_set_header X-Correlation-ID  $correlation_id;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    add_header X-Correlation-ID $correlation_id always;

    # The gateway's own health check (compose healthcheck, Azure probe).
    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # One block per service: /api/<context>/<path> reaches the service as /<path>.
    location /api/booking/ {
        set $booking_upstream ${BOOKING_URL};
        rewrite ^/api/booking/(.*)$ /$1 break;
        proxy_pass $booking_upstream;
    }

    location /api/membership/ {
        set $membership_upstream ${MEMBERSHIP_URL};
        rewrite ^/api/membership/(.*)$ /$1 break;
        proxy_pass $membership_upstream;
    }

    # The delivery log for staff (#221). In Azure it answers 502 until Notification runs there.
    location /api/notification/ {
        set $notification_upstream ${NOTIFICATION_URL};
        rewrite ^/api/notification/(.*)$ /$1 break;
        proxy_pass $notification_upstream;
    }

    # Log-in (POST /tokens, #235), limited per client address (limit_req_zone above). Otherwise routed as
    # /api/identity/ is. No proxy_set_header here: it would drop the server-level ones.
    location = /api/identity/tokens {
        limit_req zone=login burst=${LOGIN_RATE_BURST} nodelay;
        set $identity_upstream ${IDENTITY_URL};
        rewrite ^/api/identity/(.*)$ /$1 break;
        proxy_pass $identity_upstream;
    }

    location /api/identity/ {
        set $identity_upstream ${IDENTITY_URL};
        rewrite ^/api/identity/(.*)$ /$1 break;
        proxy_pass $identity_upstream;
    }

    # The MCP server (#213), with the path unchanged: /mcp reaches it as /mcp.
    location /mcp {
        set $mcp_server_upstream ${MCP_SERVER_URL};
        proxy_pass $mcp_server_upstream;
    }

    # Grafana (monitoring.yml), served under /grafana/ (GF_SERVER_SERVE_FROM_SUB_PATH), so the path is
    # passed on as it is. 502 when the monitoring group isn't running.
    location = /grafana {
        absolute_redirect off;
        return 301 /grafana/;
    }

    location /grafana/ {
        set $grafana_upstream ${GRAFANA_URL};
        proxy_pass $grafana_upstream;
    }

    # Everything else is the member portal (Blazor UI), with the path unchanged.
    location / {
        set $member_portal_upstream ${MEMBER_PORTAL_URL};
        proxy_pass $member_portal_upstream;
    }
}
