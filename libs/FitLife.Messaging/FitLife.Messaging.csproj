<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RabbitMQ events between services (#190): the event types from contracts/events/, a publisher and a consumer.
    The only project that references RabbitMQ.Client, so every service uses the same exchange, format and headers.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Shared code has its own version (docs/TECHNICAL_REFERENCE.md section 1), raised when it changes -->
    <Version>0.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>

  <ItemGroup>
    <!-- The unit tests open the consumer and publisher on a mocked IConnection -->
    <InternalsVisibleTo Include="FitLife.Messaging.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The correlation ID goes in the message headers (#19) -->
    <ProjectReference Include="$(RepoRoot)libs/FitLife.Correlation/FitLife.Correlation.csproj" />
  </ItemGroup>

</Project>
