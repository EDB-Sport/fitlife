<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared NLog config for every service (docs/TECHNICAL_REFERENCE.md section 7). Each service links it in its .csproj.
  Loki labels are app, server and version only; everything else goes in the JSON body, where LogQL's | json reads it.
  The labels and fields are what deploy/compose/grafana's dashboard and alert rules expect (deploy/compose/README.md).
  Settings from appsettings.json or environment variables: Loki:Url (Loki__Url) and Loki:App (Loki__App).
  Loki:MinLevel (Loki__MinLevel, default Info) is the lowest level sent to Loki; Off sends nothing. The test runs set Off
  (tests/test.runsettings), because no Loki answers there and the target's retries made host shutdown time out (#394).
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
    <add assembly="NLog.Loki" />
  </extensions>

  <targets async="true">
    <!-- docker logs and dotnet run: the course's text layout -->
    <target xsi:type="Console" name="console"
            layout="${longdate}|${level:uppercase=true}|${logger}|${scopeproperty:CorrelationId}|${message:withexception=true}" />

    <target xsi:type="loki" name="loki"
            endpoint="${configsetting:item=Loki.Url:default=http\://localhost\:3100}"
            orderWrites="true">
      <label name="app" layout="${configsetting:item=Loki.App}" />
      <label name="server" layout="${hostname}" />
      <label name="version" layout="${assembly-version:type=Informational}" />
      <layout xsi:type="JsonLayout" includeEventProperties="true">
        <attribute name="time" layout="${longdate}" />
        <attribute name="level" layout="${level}" />
        <attribute name="logger" layout="${logger}" />
        <attribute name="message" layout="${message}" />
        <attribute name="CorrelationId" layout="${scopeproperty:CorrelationId}" />
        <attribute name="exception" layout="${exception:format=tostring}" />
      </layout>
    </target>
  </targets>

  <variable name="lokiMinLevel" value="${configsetting:item=Loki.MinLevel:default=Info}" />

  <rules>
    <!-- Keep the startup and shutdown lines from ASP.NET Core, drop its per-request noise -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="console" />
    <logger name="Microsoft.Hosting.Lifetime" minlevel="${var:lokiMinLevel}" writeTo="loki" />
    <logger name="Microsoft.Hosting.Lifetime" final="true" />
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Info" writeTo="console" />
    <logger name="*" minlevel="${var:lokiMinLevel}" writeTo="loki" />
  </rules>
</nlog>
