<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The service's own version (METHODOLOGY section 2.1), raised on a release branch -->
    <Version>0.1.0</Version>
    <!-- The OpenAPI contract, generated on build and committed; CI fails when it is stale (docs/CSHARP_SETUP_TODO.md section 8) -->
    <OpenApiDocumentsDirectory>$(RepoRoot)contracts/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name bookingservice</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NLog.Web.AspNetCore" />
    <PackageReference Include="NLog.Targets.Loki" />
    <PackageReference Include="MongoDB.Driver" />
    <!-- Time-out, retry and circuit breaker on the call to Membership (#256) -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared code: correlation ID middleware and handler (docs/CSHARP_SETUP_TODO.md section 7) -->
    <ProjectReference Include="$(RepoRoot)libs/FitLife.Authentication/FitLife.Authentication.csproj" />
    <ProjectReference Include="$(RepoRoot)libs/FitLife.Configuration/FitLife.Configuration.csproj" />
    <ProjectReference Include="$(RepoRoot)libs/FitLife.Correlation/FitLife.Correlation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests shorten the resilience delays through an internal overload (#256) -->
    <InternalsVisibleTo Include="BookingService.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared NLog config (docs/CSHARP_SETUP_TODO.md section 7) -->
    <Content Include="$(RepoRoot)libs/nlog.config" Link="nlog.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
