<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The service's own version (METHODOLOGY section 2.1), raised on a release branch -->
    <Version>0.1.0</Version>
    <!-- No OpenAPI contract: the MCP server is a channel with no REST API (#213) -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="NLog.Web.AspNetCore" />
    <PackageReference Include="NLog.Targets.Loki" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared code: correlation ID middleware and handler (docs/TECHNICAL_REFERENCE.md section 7) -->
    <ProjectReference Include="$(RepoRoot)libs/FitLife.Correlation/FitLife.Correlation.csproj" />
    <!-- FitLifeJwt.AccountIdClaim, and the token reader the rate limit and the call log read the account id with (#216) -->
    <ProjectReference Include="$(RepoRoot)libs/FitLife.Authentication/FitLife.Authentication.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared NLog config (docs/TECHNICAL_REFERENCE.md section 7) -->
    <Content Include="$(RepoRoot)libs/nlog.config" Link="nlog.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
