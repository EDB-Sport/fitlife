{
  "info": {
    "_postman_id": "cb5cf188-89da-56af-b322-c5cad25280c3",
    "name": "FitLife account registration (mock tests)",
    "description": "API tests against the account registration Postman Mock Server: the happy path and the error cases. Needs accountRegistrationMockUrl from an environment in tests/postman/environments/.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create account: 201 Created",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Body is an account without a password\", function () {",
              "    const account = pm.response.json();",
              "    pm.expect(account.id).to.match(/^[0-9a-f-]{36}$/);",
              "    pm.expect(account.email).to.eql(\"anna.jensen@example.com\");",
              "    pm.expect(account).to.have.property(\"firstName\");",
              "    pm.expect(account).to.have.property(\"lastName\");",
              "    pm.expect(account).to.not.have.property(\"password\");",
              "});",
              "",
              "pm.test(\"Location points at the new account\", function () {",
              "    pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/accounts/\" + pm.response.json().id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-mock-response-name",
            "value": "account-created"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{accountRegistrationMockUrl}}/accounts",
          "host": [
            "{{accountRegistrationMockUrl}}"
          ],
          "path": [
            "accounts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"anna.jensen@example.com\",\n  \"password\": \"Example-Passw0rd\",\n  \"firstName\": \"Anna\",\n  \"lastName\": \"Jensen\"\n}"
        }
      }
    },
    {
      "name": "Create account: 400 on invalid input",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test(\"Body is a ProblemDetails with status 400\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
              "    const body = pm.response.json();",
              "    pm.expect(body.status).to.eql(400);",
              "    pm.expect(body.title).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "pm.test(\"Names the invalid fields\", function () {",
              "    const errors = pm.response.json().errors;",
              "    pm.expect(errors).to.have.property(\"email\");",
              "    pm.expect(errors).to.have.property(\"password\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-mock-response-name",
            "value": "account-invalid"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{accountRegistrationMockUrl}}/accounts",
          "host": [
            "{{accountRegistrationMockUrl}}"
          ],
          "path": [
            "accounts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"short\",\n  \"firstName\": \"Anna\",\n  \"lastName\": \"Jensen\"\n}"
        }
      }
    },
