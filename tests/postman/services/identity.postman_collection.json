          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"The run's new account is in the list, without a password or hash\", function () {",
              "    const accounts = pm.response.json();",
              "    const account = accounts.find((a) => a.id === pm.collectionVariables.get(\"accountId\"));",
              "    pm.expect(account, \"new account in the list\").to.be.an(\"object\");",
              "    pm.expect(account.email).to.eql(pm.collectionVariables.get(\"accountEmail\"));",
              "    accounts.forEach((a) => {",
              "        Object.keys(a).forEach((key) => pm.expect(key).to.not.match(/password|hash/i));",
              "    });",
              "});"
            ]
          }
        }
