{
  "info": {
    "_postman_id": "5d0a5f0e-7c1b-4c55-9a3e-6a1f2b8c9d40",
    "name": "FitLife Identity",
    "description": "API tests of the Identity service through the gateway: a person creates an account and logs in, and each wrong input gets the agreed answer. Needs baseUrl, traenerEmail and traenerPassword from an environment in tests/postman/environments/. Nothing is removed: no endpoint deletes an account, so every run uses a new e-mail address.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// One e-mail address and one password per run, made once and kept. {{$guid}} is new each time it is used.",
          "if (!pm.collectionVariables.get(\"accountEmail\")) {",
          "    pm.collectionVariables.set(\"accountEmail\", pm.variables.replaceIn(\"{{$guid}}@example.test\"));",
          "    pm.collectionVariables.set(\"accountEmailUpper\", pm.collectionVariables.get(\"accountEmail\").toUpperCase());",
          "    pm.collectionVariables.set(\"accountPassword\", pm.variables.replaceIn(\"pw-{{$guid}}\"));",
          "    pm.collectionVariables.set(\"unknownEmail\", pm.variables.replaceIn(\"unknown-{{$guid}}@example.test\"));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "accountEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "accountEmailUpper",
      "value": "",
      "type": "string"
    },
    {
      "key": "accountPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "unknownEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "accountId",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create account",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Body is the new account, without a password\", function () {",
              "    const account = pm.response.json();",
              "    pm.expect(account.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
              "    pm.expect(account.email).to.eql(pm.collectionVariables.get(\"accountEmail\"));",
              "    pm.expect(account.roles).to.eql([\"Medlem\"]);",
              "    pm.expect(account).to.not.have.property(\"password\");",
              "    pm.collectionVariables.set(\"accountId\", account.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/identity/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "identity",
            "accounts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{accountEmail}}\",\n  \"password\": \"{{accountPassword}}\"\n}"
        }
      }
    },
    {
      "name": "Create account: e-mail taken",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 409\", function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "pm.test(\"Code is EmailAlreadyTaken\", function () {",
              "    pm.expect(pm.response.json().code).to.eql(\"EmailAlreadyTaken\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/identity/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "identity",
            "accounts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{accountEmailUpper}}\",\n  \"password\": \"{{accountPassword}}\"\n}"
        }
      }
    },
    {
      "name": "Create account: not an address",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test(\"Body is a problem with status 400\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
              "    pm.expect(pm.response.json().status).to.eql(400);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/identity/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "identity",
            "accounts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"not-an-address\",\n  \"password\": \"{{accountPassword}}\"\n}"
        }
      }
    },
    {
      "name": "Create account: password of 7 characters",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test(\"Body is a problem with status 400\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
              "    pm.expect(pm.response.json().status).to.eql(400);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/identity/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "identity",
            "accounts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{accountEmail}}\",\n  \"password\": \"seven77\"\n}"
        }
      }
    },
    {
      "name": "Log in",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"accessToken is not empty and its sub claim is the account id\", function () {",
              "    const accessToken = pm.response.json().accessToken;",
              "    pm.expect(accessToken).to.be.a(\"string\").and.not.empty;",
              "    const payload = accessToken.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\");",
              "    const claims = JSON.parse(require(\"atob\")(payload + \"=\".repeat((4 - (payload.length % 4)) % 4)));",
              "    pm.expect(claims.sub).to.eql(pm.collectionVariables.get(\"accountId\"));",
              "    pm.collectionVariables.set(\"accessToken\", accessToken);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/identity/tokens",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "identity",
            "tokens"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{accountEmail}}\",\n  \"password\": \"{{accountPassword}}\"\n}"
        }
      }
    },
    {
      "name": "Log in: wrong password",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test(\"Body has no accessToken\", function () {",
              "    pm.expect(pm.response.json()).to.not.have.property(\"accessToken\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/identity/tokens",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "identity",
            "tokens"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{accountEmail}}\",\n  \"password\": \"{{accountPassword}}-wrong\"\n}"
        }
      }
    },
    {
      "name": "Log in: unknown e-mail",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test(\"Body has no accessToken\", function () {",
              "    pm.expect(pm.response.json()).to.not.have.property(\"accessToken\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/identity/tokens",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "identity",
            "tokens"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{unknownEmail}}\",\n  \"password\": \"{{accountPassword}}\"\n}"
        }
      }
    },
    {
      "name": "Log in as the Træner demo account",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"accessToken is not empty\", function () {",
              "    pm.expect(pm.response.json().accessToken).to.be.a(\"string\").and.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/identity/tokens",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "identity",
            "tokens"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{traenerEmail}}\",\n  \"password\": \"{{traenerPassword}}\"\n}"
        }
      }
    }
  ]
}
