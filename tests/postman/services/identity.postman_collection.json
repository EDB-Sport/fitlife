    {
      "name": "Log in as the new account, with the role Træner",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"The token has a role claim Træner\", function () {",
              "const token = pm.response.json().accessToken;",
              "const payload = token.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\");",
              "const binary = require(\"atob\")(payload + \"=\".repeat((4 - (payload.length % 4)) % 4));",
              "const utf8 = decodeURIComponent(binary.split(\"\").map((c) => \"%\" + c.charCodeAt(0).toString(16).padStart(2, \"0\")).join(\"\"));",
              "const claims = JSON.parse(utf8);",
              "const roles = [].concat(claims.role || []);",
              "    pm.expect(roles).to.include(\"Træner\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/identity/tokens",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "identity",
            "tokens"
