{
  "info": {
    "_postman_id": "7f3c2a91-6b4e-4d58-9a10-2c8e5f7b0d34",
    "name": "FitLife Notification",
    "description": "API tests of the Notification service through the gateway: staff can read a member's delivery log, a member can't, and nobody can without a token. Needs baseUrl, traenerEmail and traenerPassword from an environment in tests/postman/environments/. Nothing is removed: no endpoint deletes an account, so every run uses a new e-mail address.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// One e-mail address and one password per run, made once and kept. {{$guid}} is new each time it is used.",
          "if (!pm.collectionVariables.get(\"accountEmail\")) {",
          "    pm.collectionVariables.set(\"accountEmail\", pm.variables.replaceIn(\"{{$guid}}@example.test\"));",
          "    pm.collectionVariables.set(\"accountPassword\", pm.variables.replaceIn(\"pw-{{$guid}}\"));",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "accountEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "accountPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "memberId",
      "value": "",
      "type": "string"
    },
    {
      "key": "traenerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "ownToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Log in as the Træner demo account",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Keeps the Træner token\", function () {",
              "    pm.expect(pm.response.json().accessToken).to.be.a(\"string\").and.not.empty;",
              "    pm.collectionVariables.set(\"traenerToken\", pm.response.json().accessToken);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/identity/tokens",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "identity",
            "tokens"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{traenerEmail}}\",\n  \"password\": \"{{traenerPassword}}\"\n}"
        }
      }
    },
    {
      "name": "Create account",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"The new account is a Medlem\", function () {",
              "    const account = pm.response.json();",
              "    pm.expect(account.email).to.eql(pm.collectionVariables.get(\"accountEmail\"));",
              "    pm.expect(account.roles).to.eql([\"Medlem\"]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/identity/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "identity",
            "accounts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{accountEmail}}\",\n  \"password\": \"{{accountPassword}}\"\n}"
        }
      }
    },
    {
      "name": "Log in as the new account",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Keeps the new account's token\", function () {",
              "    pm.expect(pm.response.json().accessToken).to.be.a(\"string\").and.not.empty;",
              "    pm.collectionVariables.set(\"ownToken\", pm.response.json().accessToken);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/identity/tokens",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "identity",
            "tokens"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{accountEmail}}\",\n  \"password\": \"{{accountPassword}}\"\n}"
        }
      }
    },
    {
      "name": "Delivery log",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// A member with no notifications: a new id per run. {{$guid}} is new each time it is used, so make it once and keep it.",
              "if (!pm.collectionVariables.get(\"memberId\")) {",
              "    pm.collectionVariables.set(\"memberId\", pm.variables.replaceIn(\"{{$guid}}\"));",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Body is an empty list\", function () {",
              "    pm.expect(pm.response.json()).to.be.an(\"array\").that.is.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{traenerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notification/notifications?memberId={{memberId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notification",
            "notifications"
          ],
          "query": [
            {
              "key": "memberId",
              "value": "{{memberId}}"
            }
          ]
        }
      }
    },
    {
      "name": "Delivery log: as a member",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 403\", function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ownToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notification/notifications?memberId={{memberId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notification",
            "notifications"
          ],
          "query": [
            {
              "key": "memberId",
              "value": "{{memberId}}"
            }
          ]
        }
      }
    },
    {
      "name": "Delivery log: no token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notification/notifications?memberId={{memberId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notification",
            "notifications"
          ],
          "query": [
            {
              "key": "memberId",
              "value": "{{memberId}}"
            }
          ]
        }
      }
    },
    {
      "name": "Delivery log: no member id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test(\"Body is a problem with status 400\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
              "    pm.expect(pm.response.json().status).to.eql(400);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{traenerToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/notification/notifications",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "notification",
            "notifications"
          ]
        }
      }
    }
  ]
}
