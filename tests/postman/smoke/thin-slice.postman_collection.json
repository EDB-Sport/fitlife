{
  "info": {
    "_postman_id": "6d3c1901-7713-547e-9421-2135aca962c8",
    "name": "FitLife thin-slice smoke test",
    "description": "Run by .github/workflows/deploy.yml right after a deploy to Azure (docs/CSHARP_SETUP_TODO.md section 9a). Checks every hop: Caddy (HTTPS) -> Nginx -> Booking, Membership and Identity and the member portal, and logs in as the Medlem demo account (#371). baseUrl comes from the Bicep output, medlemPassword from the secret DEMO_MEDLEM_PASSWORD (a globals file that deploy.yml writes at run time, never a committed file). memberPortal is false while the portal has no release, and then its checks are skipped (#198).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Gateway answers over HTTPS",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('body is ok', () => pm.expect(pm.response.text().trim()).to.eql('ok'));",
              "pm.test('gateway sets a correlation ID', () => pm.expect(pm.response.headers.get('X-Correlation-ID')).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Gateway keeps the caller's correlation ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the same correlation ID comes back', () => pm.expect(pm.response.headers.get('X-Correlation-ID')).to.eql('smoke-test-correlation-id'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "smoke-test-correlation-id"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Booking is healthy through the gateway",
      "event": [
