{
  "info": {
    "_postman_id": "6d3c1901-7713-547e-9421-2135aca962c8",
    "name": "FitLife thin-slice smoke test",
    "description": "Run by .github/workflows/deploy.yml right after a deploy to Azure (docs/CSHARP_SETUP_TODO.md section 9a). Checks every hop of the thin slice: Caddy (HTTPS) -> Nginx -> the service and the member portal. baseUrl and serviceBasePath come from the Bicep outputs. memberPortal is false while the portal has no release, and then its checks are skipped (#198).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Gateway answers over HTTPS",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('body is ok', () => pm.expect(pm.response.text().trim()).to.eql('ok'));",
              "pm.test('gateway sets a correlation ID', () => pm.expect(pm.response.headers.get('X-Correlation-ID')).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Gateway keeps the caller's correlation ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('the same correlation ID comes back', () => pm.expect(pm.response.headers.get('X-Correlation-ID')).to.eql('smoke-test-correlation-id'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "smoke-test-correlation-id"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Service is healthy through the gateway",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}{{serviceBasePath}}/health",
          "host": [
            "{{baseUrl}}{{serviceBasePath}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Member portal serves its home page",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// deploy.yml passes memberPortal=false while the portal has no release, so it isn't deployed (#198).",
              "const portalTest = pm.variables.get('memberPortal') === 'false' ? pm.test.skip : pm.test;",
              "portalTest('status is 200', () => pm.response.to.have.status(200));",
              "portalTest('it is HTML', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": []
        }
      },
      "response": []
    }
  ]
}
