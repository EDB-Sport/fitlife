          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/membership/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "membership",
            "health"
          ]
        }
      },
