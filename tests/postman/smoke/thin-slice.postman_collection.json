          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/booking/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "booking",
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Membership is healthy through the gateway",
      "event": [
        {
