    },
    {
      "name": "Identity is healthy through the gateway",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/identity/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "identity",
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "The Medlem demo account logs in",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Identity answers /health only after its seed has run (#237), so the account exists by now.",
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const accessToken = pm.response.code === 200 ? pm.response.json().accessToken : undefined;",
              "pm.test('the response has an access token', () => pm.expect(accessToken).to.be.a('string').and.not.empty);",
              "pm.test('the token has the role Medlem', () => {",
              "  const payload = accessToken.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
              "  const claims = JSON.parse(atob(payload));",
              "  pm.expect([].concat(claims.role)).to.eql(['Medlem']);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{medlemEmail}}\", \"password\": \"{{medlemPassword}}\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/identity/tokens",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "identity",
            "tokens"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Member portal serves its home page",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// deploy.yml passes memberPortal=false while the portal has no release, so it isn't deployed (#198).",
              "const portalTest = pm.variables.get('memberPortal') === 'false' ? pm.test.skip : pm.test;",
              "portalTest('status is 200', () => pm.response.to.have.status(200));",
              "portalTest('it is HTML', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": []
        }
      },
      "response": []
    }
  ]
