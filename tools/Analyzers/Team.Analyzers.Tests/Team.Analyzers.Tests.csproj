<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests for the TEAM analyzers: for each rule, snippets that must raise the diagnostic and snippets that must not.
    This project is under tools/, not tests/, so tests/Directory.Build.props doesn't apply: the test packages are listed here.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="coverlet.collector" />
    <!-- The test framework for analyzers, used through DefaultVerifier, so no *.XUnit/*.NUnit wrapper package is needed -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" />
    <!-- The testing package only asks for Workspaces 1.0.1; pin it to the Roslyn version the analyzer is built against -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <!-- Lifts a vulnerable transitive version out of the testing package; remove it once the testing package no longer needs it -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Team.Analyzers/Team.Analyzers.csproj" />
  </ItemGroup>
</Project>
